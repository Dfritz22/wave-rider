[Unit]
Description=wave-rider SPY MOC-imbalance detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wave-rider
EnvironmentFile=/opt/wave-rider/.env
ExecStart=/opt/wave-rider/.venv/bin/python -u main.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/wave-rider.log
StandardError=append:/var/log/wave-rider.log

[Install]
WantedBy=multi-user.target
